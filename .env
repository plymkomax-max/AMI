# AMI Configuration
# Скопируйте в .env и настройте. Секреты в коде не хранятся.

# --- Приложение ---
AMI_DEBUG=false
AMI_APP_NAME="AMI - Avito Market Intelligence"
AMI_APP_VERSION="0.2.0"

# --- API ---
AMI_API_HOST=127.0.0.1
AMI_API_PORT=8000
AMI_API_WORKERS=1
# Список origin через запятую; * разрешает всё (только для локальной разработки)
AMI_ALLOWED_ORIGINS=*
# Если задать ключ, все /api/v1/* (кроме health/info) потребуют заголовок X-API-Key
AMI_API_KEY=

# --- База данных ---
# Относительный путь считается от каталога backend/, а не от текущего каталога.
AMI_DATABASE_URL=sqlite:///./ami.db
# PostgreSQL (нужен requirements-postgres.txt):
# AMI_DATABASE_URL=postgresql+asyncpg://ami:password@127.0.0.1:5432/ami
AMI_DB_ECHO=false

# --- Каталоги ---
# Относительные пути также считаются от backend/
AMI_DATA_DIR=./data
AMI_LOG_DIR=./logs
AMI_ML_MODEL_DIR=./models

# --- LLM (Ollama устанавливается отдельно) ---
AMI_OLLAMA_BASE_URL=http://127.0.0.1:11434
AMI_OLLAMA_MODEL=qwen3:1.7b
AMI_OLLAMA_TIMEOUT_S=180
AMI_LLM_MAX_TOKENS=1024
AMI_LLM_TEMPERATURE=0.1

# --- ML ---
AMI_ML_MIN_CONFIDENCE=0.55

# --- Сбор данных ---
AMI_DATA_COLLECTION_ENABLED=true
AMI_DATA_COLLECTION_INTERVAL_MIN=60
AMI_MAX_LISTINGS_PER_SOURCE=5000
AMI_REQUEST_TIMEOUT_S=30
AMI_MAX_RETRIES=3

# --- Аналитика ---
# Минимальный размер выборки для оценки/аномалии; меньше — "недостаточно данных"
AMI_MIN_SAMPLE=5

# --- Сопоставление объявлений с моделями ---
AMI_AUTO_MATCH_ENABLED=true
AMI_MATCH_MIN_CONFIDENCE=0.55

# --- Telegram (опционально) ---
AMI_TELEGRAM_BOT_TOKEN=
AMI_TELEGRAM_CHAT_ID=
